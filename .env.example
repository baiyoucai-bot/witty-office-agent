# 复制成 .env 后填值（.env 已被 git 忽略，不会提交）。
# 注意：witty-agent 不会自动加载 .env——用你习惯的方式注入环境变量：
#   source .env && uv run witty-agent serve      # 手动（需在每行前加 export，或用下面这句）
#   set -a; source .env; set +a                  # 让普通 KEY=VALUE 行也导出
#   direnv / docker --env-file / systemd EnvironmentFile 亦可

# ---- 模型（必填就这三样：一个 OpenAI 兼容端点 + 钥匙 + 模型名）----
WITTY_API_KEY=sk-your-key-here
WITTY_BASE_URL=https://api.example.com/v1
WITTY_MODEL_ID=your-model-id

# 没设 WITTY_API_KEY 时的后备钥匙
# OPENAI_API_KEY=

# 请求超时（秒）与单次生成上限（不设则用 config/runtime.toml 的默认值）
# WITTY_TIMEOUT_SEC=3600
# WITTY_MAX_TOKENS=2048

# ---- 日志 ----
# DEBUG / INFO / WARNING。serve 默认 INFO；库用法默认 WARNING
# WITTY_LOG_LEVEL=INFO

# ---- 数据与配置落点 ----
# 全局数据目录（项目、保险柜、沙箱、审批收件箱），默认 ~/.witty/data
# WITTY_HOME=
# 换整份提示词 / 运行时配置
# WITTY_PROMPTS_FILE=
# WITTY_RUNTIME_FILE=
# 额外技能目录，冒号分隔
# WITTY_SKILLS_PATH=

# ---- HTTP 服务鉴权（witty-agent serve）----
# 不设 = 本机模式（默认只绑 127.0.0.1，无鉴权）。要把端口暴露给别的机器时必须设：
# 客户端请求带 Authorization: Bearer <token>。注意桌面壳按本机无 token 设计
# WITTY_API_TOKEN=

# ---- 网络策略 ----
# 1 = 锁公网（内网部署），只放行私网与 runtime.toml 的 allow_hosts
# WITTY_WEB_DENY_PUBLIC=0

# ---- 网络搜索（web_search 工具）----
# 默认服务商 tavily（tavily.com 免费额度可用），后备变量名 TAVILY_API_KEY 也认。
# 内网/不想用云端：把 runtime.toml 的 [web].search_provider 改成 searxng 并配自建实例地址，无需 key
# WITTY_SEARCH_API_KEY=

# ---- 库用法（pip 安装后后台调用）的权限 ----
# allow | ask | read-only | deny
# WITTY_LIBRARY_PERMISSION=ask
# WITTY_LIBRARY_TIMEOUT_SEC=30
# WITTY_LIBRARY_ON_TIMEOUT=allow

# ---- 邮件（配了 IMAP/SMTP 主机才需要；主机等非密配置在 runtime.toml [email]）----
# WITTY_IMAP_PASSWORD=
# WITTY_SMTP_PASSWORD=

# ---- Windows ----
# 找不到 bash.exe 时指路（Git for Windows 的 bash）
# WITTY_BASH=
